{
  "name": "dsh-k-bloom-theme",
  "version": "0.19.0",
  "description": "Bloom for DSH — 玻璃+莫兰迪主题（自用分支）。10 套 OKLCH 配色（黛蓝/朱砂/桃夭/天青/竹青/赭石/青金/琥珀/落霞/青莲），明暗自适应；磨砂玻璃面板默认常开；微动效 + 版本/更新指示。零依赖、TypeScript、WCAG AA。",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "build:watch": "node scripts/bundle.mjs --watch",
    "package": "npm run build && npm pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puny-code/dsh-k-bloom-theme.git"
  },
  "bugs": {
    "url": "https://github.com/puny-code/dsh-k-bloom-theme/issues"
  },
  "homepage": "https://github.com/puny-code/dsh-k-bloom-theme#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-theme",
    "deepseek-harness",
    "deepseek",
    "harness",
    "theme",
    "skin",
    "dark-theme",
    "ui-theme",
    "web-ui",
    "bloom",
    "morandi",
    "oklch",
    "accessibility",
    "wcag",
    "wallpaper",
    "glassmorphism"
  ],
  "license": "MIT",
  "files": [
    "cordis.patch.yml",
    "lib",
    "src",
    "scripts",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
